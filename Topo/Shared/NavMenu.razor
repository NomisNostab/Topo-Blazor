@inject Topo.Services.StorageService _storageService
@inject Blazored.LocalStorage.ILocalStorageService _localStorageService
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@implements IDisposable

<div class="top-row navbar navbar-dark @(_storageService.NavMenuIconOnly ? "icon-only" : "ps-3")">
    <div class="container-fluid">
        <a class="navbar-brand" href="#">
            <img src="G12-Map-icon-64.png" width="20" height="20" class="d-inline-block align-top" alt=""> <!--Icon from http://raindropmemory.deviantart.com/-->
            <span class="nav-text">Topo</span>
        </a>
        <button title="@(_storageService.NavMenuIconOnly ? "Expand menu" : "Collapse to icons")" class="icon-toggler" @onclick="ToggleIconOnly">
            <span class="oi @(_storageService.NavMenuIconOnly ? "oi-chevron-right" : "oi-chevron-left")" aria-hidden="true"></span>
        </button>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        @* The groups and links, and their order, are listed in NavMenuItems.cs *@
        @foreach (var group in NavMenuItems.Groups.Where(g => NavMenuItems.IsShownTo(g.Audience, viewer)))
        {
            if (group.Title != null)
            {
                var open = IsOpen(group);
                <div class="nav-group-label px-3" title="@group.Title" @onclick="() => ToggleGroup(group)" @onclick:stopPropagation="true">
                    <span class="nav-text">@group.Title</span>
                    <span class="oi @(open ? "oi-chevron-top" : "oi-chevron-bottom")" aria-hidden="true"></span>
                </div>
            }
            if (group.Title == null || IsOpen(group))
            {
                foreach (var item in group.Items.Where(i => NavMenuItems.IsShownTo(i.Audience, viewer)))
                {
                    var text = item.TitleText(_storageService);
                    <div class="nav-item px-3">
                        @if (item.IsExternal)
                        {
                            <a class="nav-link" href="@item.Href" target="_blank" title="@text"><span class="oi @item.Icon" aria-hidden="true"></span> <span class="nav-text">@text</span></a>
                        }
                        else
                        {
                            <NavLink class="@LinkClass(item)" href="@item.Href" Match="item.Match" title="@text">
                                <span class="oi @item.Icon" aria-hidden="true"></span> <span class="nav-text">@text</span>
                            </NavLink>
                        }
                    </div>
                }
            }
        }
        <div class="nav-item version-item px-3">
            <NavLink class="nav-link" href="https://github.com/NomisNostab/Topo-Blazor/releases/latest" target="_blank" title="@($"Version {_storageService.Version}")">
                <span class="" aria-hidden="true"></span> <span class="nav-text">Version @_storageService.Version</span>
            </NavLink>
        </div>

    </nav>
</div>

@code {
    private bool collapseNavMenu = true;

    // which collapsible groups have been opened or closed; a group not in here uses its default
    private readonly Dictionary<string, bool> groupOpen = new();

    private NavAudience viewer => NavMenuItems.AudienceFor(_storageService);

    private string NavMenuCssClass => "nav-scroll-area " + (collapseNavMenu ? "collapse " : "") + (_storageService.NavMenuIconOnly ? "icon-only" : "");

    private bool IsOpen(NavGroup group) => groupOpen.TryGetValue(group.Title!, out var open) ? open : group.OpenByDefault;

    // an item that names an ActivePrefix stays highlighted on any page under it (Scouting History has a Member and a Unit page)
    private string LinkClass(NavItem item) =>
        "nav-link" + (item.ActivePrefix != null && NavigationManager.ToBaseRelativePath(NavigationManager.Uri).StartsWith(item.ActivePrefix, StringComparison.OrdinalIgnoreCase) ? " active" : "");

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private async Task ToggleIconOnly()
    {
        _storageService.NavMenuIconOnly = !_storageService.NavMenuIconOnly;
        await _localStorageService.SetItemAsync("NavMenuIconOnly", _storageService.NavMenuIconOnly);
    }

    private async Task ToggleGroup(NavGroup group)
    {
        var open = !IsOpen(group);
        groupOpen[group.Title!] = open;
        await JS.InvokeVoidAsync("sessionStorage.setItem", $"NavGroup_{group.Title}", open ? "1" : "0");
    }

    protected override async Task OnInitializedAsync()
    {
        _storageService.OnChange += StateHasChanged;
        NavigationManager.LocationChanged += OnLocationChanged;
        _storageService.NavMenuIconOnly = await _localStorageService.GetItemAsync<bool>("NavMenuIconOnly");
        foreach (var group in NavMenuItems.Groups.Where(g => g.Title != null))
        {
            var saved = await JS.InvokeAsync<string?>("sessionStorage.getItem", $"NavGroup_{group.Title}");
            if (saved != null)
                groupOpen[group.Title!] = saved == "1";
        }
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => StateHasChanged();

    public void Dispose()
    {
        _storageService.OnChange -= StateHasChanged;
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}
