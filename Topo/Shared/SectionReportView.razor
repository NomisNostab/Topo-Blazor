@using System.Globalization
@using Topo.Model.SectionReport
@using Topo.Model.UnitReport

@* A section's report for the period, or the group's with its totals first, laid out like the exported pdf: grey headed blocks
   of label and detail rows. Who left is chosen here, so the counts update as the pills are clicked and the same object is
   what gets exported. *@
<div class="report">
    <div class="report-header">
        @if (LogoFile != "")
        {
            <img class="report-logo" src="logos/@LogoFile" alt="" />
        }
        <div class="report-title">
            <div class="report-group">@Report.GroupName</div>
            <div class="report-name">@(Report.IsGroup ? "Group Report" : "Section Report")</div>
            @if (!Report.IsGroup && Report.Sections.Count == 1)
            {
                <div class="report-unit">@Report.Sections[0].UnitName</div>
            }
        </div>
    </div>
    <div>Generated @Report.GeneratedAt.ToString("d MMM yyyy 'at' h:mm tt") by @Report.GeneratedBy</div>
    <div>For the period @Report.From.ToString("d MMM yyyy") to @Report.To.ToString("d MMM yyyy")</div>

    @if (Report.IsGroup)
    {
        <div class="block">Group totals</div>
        <div class="line"><div class="label">Youth</div><div class="detail">
            <div>@Report.TotalYouth current youth @(Report.TotalYouth == 1 ? "member" : "members") (as at @AsAt)</div>
            <div>@Report.TotalInvested invested, @Report.TotalInvestedInPeriod invested in this period</div>
        </div></div>
        <div class="line"><div class="label">New members</div><div class="detail">
            <div>From a younger section: @Report.TotalNewFromYounger</div>
            <div>Off the street: @Report.TotalNewOffTheStreet</div>
            <div>From another group: @Report.TotalNewFromAnotherGroup</div>
        </div></div>
        <div class="line"><div class="label">Members leaving</div><div class="detail">
            <div>Moving up: @Report.TotalMovedUp</div>
            <div>Moved groups: @Report.TotalMovedGroup</div>
            <div>Left Scouting: @Report.TotalLeftScouting</div>
        </div></div>
        <div class="line"><div class="label">Youth helpers</div><div class="detail">@Report.TotalYouthHelpers</div></div>
        <div class="line"><div class="label">Leaders</div><div class="detail">@Report.TotalLeaders current @(Report.TotalLeaders == 1 ? "leader" : "leaders")</div></div>
        <div class="line"><div class="label">Awarded in the period</div><div class="detail">
            <div>Peak Awards: @Report.TotalPeakAwards</div>
            <div>Milestones: @Report.TotalMilestones</div>
            <div>Special Interest Areas: @Report.TotalSia</div>
            <div>Outdoor Adventure Skill progressions: @Report.TotalOasProgressions</div>
            <div>Additional Awards: @Report.TotalAdditionalAwards</div>
        </div></div>
        <div class="line"><div class="label">Badges needed</div><div class="detail">
            <div>Outdoor Adventure Skill badges: @Report.TotalOasBadges</div>
        </div></div>
        <div class="line"><div class="label">For new members</div><div class="detail">
            @foreach (var item in Report.TotalInvestitureItems)
            {
                <div>@item.Name: @item.Count</div>
            }
            @if (!Report.TotalInvestitureItems.Any())
            {
                <div>None</div>
            }
        </div></div>
    }

    @foreach (var unit in Report.Sections)
    {
        var badges = unit.Badges;

        <div class="block">@(Report.IsGroup ? unit.UnitName : "Members")</div>
        <div class="line"><div class="label">Youth</div><div class="detail">
            <div>@unit.CurrentYouth current youth @(unit.CurrentYouth == 1 ? "member" : "members") (as at @AsAt)</div>
            <div>@unit.InvestedYouth invested, @unit.InvestedInPeriod invested in this period</div>
        </div></div>
        @if (unit.Ages.Counted > 0)
        {
            <div class="line"><div class="label">Ages</div><div class="detail">
                <div>Average @AgeProfile.Format(unit.Ages.AverageYears) (youngest @AgeProfile.Format(unit.Ages.YoungestYears), oldest @AgeProfile.Format(unit.Ages.OldestYears)) as at @AsAt</div>
                <div>Spread: @unit.Ages.Spread</div>
                @{ var tallest = Math.Max(1, unit.Ages.Buckets.Max(b => b.Count)); }
                <div class="ages">
                    @foreach (var bucket in unit.Ages.Buckets)
                    {
                        <div class="age" title="@bucket.Count aged @bucket.Age">
                            <span class="age-count">@bucket.Count</span>
                            <div class="age-bar @(bucket.Count == 0 ? "empty" : "")" style="height: @((bucket.Count * 1.8 / tallest).ToString("0.##", CultureInfo.InvariantCulture))rem;"></div>
                            <span class="age-label">@bucket.Age</span>
                        </div>
                    }
                </div>
            </div></div>
        }
        <div class="line"><div class="label">New members</div><div class="detail">
            @if (unit.Section != "joey")
            {
                <div>From the @Title(SectionReportBuilder.PreviousSectionOf(unit.Section))s: @unit.NewFromYoungerSection@NamesOf(unit, NewMemberOrigin.YoungerSection)</div>
            }
            <div>Off the street: @unit.NewOffTheStreet@NamesOf(unit, NewMemberOrigin.OffTheStreet)</div>
            <div>From another group: @unit.NewFromAnotherGroup@NamesOf(unit, NewMemberOrigin.AnotherGroup)</div>
        </div></div>
        <div class="line"><div class="label">Members leaving</div><div class="detail">
            @if (unit.NextSection != "")
            {
                <div>Moving up to the @(Title(unit.NextSection))s: @unit.MovedUp</div>
            }
            <div>Moved groups: @unit.MovedGroup</div>
            <div>Left Scouting: @unit.LeftScouting</div>
            @if (unit.DepartedUnset > 0)
            {
                <div class="text-danger">Not yet sorted: @unit.DepartedUnset</div>
            }
            @if (unit.Departed.Count == 0)
            {
                <div class="text-muted">No one found who has left the unit.</div>
            }
            @foreach (var departed in unit.Departed)
            {
                <div class="departed">
                    <span>@departed.Name</span>
                    @if (!string.IsNullOrEmpty(departed.Source))
                    {
                        <span class="small text-muted">@departed.Source</span>
                    }
                    <span class="ms-auto"><DepartureToggle Member="departed" Changed="@(_ => StateHasChanged())" /></span>
                </div>
            }
        </div></div>
        <div class="line"><div class="label">Youth helpers</div><div class="detail">@unit.YouthHelpers.Count (under 18 with a leader role in the unit)</div></div>
        <div class="line"><div class="label">Leaders</div><div class="detail">
            <div>@unit.CurrentLeaders current @(unit.CurrentLeaders == 1 ? "leader" : "leaders")</div>
            @if (unit.SavedRosterDate == null)
            {
                <div class="text-muted">New leaders can't be named: no earlier report's roster has been saved</div>
            }
            else
            {
                <div>New: @(unit.NewLeaders.Count == 0 ? "none" : string.Join(", ", unit.NewLeaders))</div>
            }
            <div>Departed: @(unit.DepartedLeaders.Count == 0 ? "none" : string.Join(", ", unit.DepartedLeaders))</div>
        </div></div>

        <div class="block">@(Report.IsGroup ? unit.UnitName + ": activities" : "Activities")</div>
        <div class="line"><div class="label">Past events</div><div class="detail">
            @foreach (var evt in unit.PastEvents)
            {
                <div>@evt.Start.ToString("d MMM yyyy") - @evt.Title (@evt.ChallengeArea) - @evt.YouthAttended youth, @evt.LeadersAttended @(evt.LeadersAttended == 1 ? "leader" : "leaders")</div>
            }
            @if (unit.PastEvents.Count == 0)
            {
                <div>None</div>
            }
        </div></div>
        <div class="line"><div class="label">Upcoming events</div><div class="detail">
            @foreach (var evt in unit.UpcomingEvents)
            {
                <div>@evt.Start.ToString("d MMM yyyy") - @evt.Title (@evt.ChallengeArea)</div>
            }
            @if (unit.UpcomingEvents.Count == 0)
            {
                <div>None</div>
            }
        </div></div>

        <div class="block">@(Report.IsGroup ? unit.UnitName + ": awarded in the period" : "Awarded in the period")</div>
        <div class="line"><div class="label">Totals</div><div class="detail">
            <div>Peak Awards: @badges.PeakAwards</div>
            <div>Milestones: @badges.MilestonesTotal</div>
            <div>Special Interest Areas: @badges.SiaTotal</div>
            <div>Outdoor Adventure Skill progressions: @badges.OasProgressions</div>
            <div>Additional Awards: @badges.AdditionalAwardsTotal</div>
        </div></div>

        <div class="block">@(Report.IsGroup ? unit.UnitName + ": badges used" : "Badges used")</div>
        <div class="line"><div class="label">Peak Award</div><div class="detail">@badges.PeakAwards</div></div>
        <div class="line"><div class="label">Milestones</div><div class="detail">
            <div>Total: @badges.MilestonesTotal</div>
            @foreach (var m in badges.Milestones) { <div>@m.Name: @m.Count</div> }
        </div></div>
        <div class="line"><div class="label">Outdoor Adventure Skills</div><div class="detail">
            <div>Badges: @badges.OasBadgesTotal</div>
            @foreach (var o in badges.OasStages) { <div>@o.Stream stage @o.Stage: @o.Count</div> }
        </div></div>
        <div class="line"><div class="label">Special Interest Areas</div><div class="detail">
            <div>Total: @badges.SiaTotal</div>
            @foreach (var s in badges.SiaCategories) { <div>@s.Name: @s.Count</div> }
        </div></div>
        <div class="line"><div class="label">Other badges</div><div class="detail">
            <div>Total: @badges.AdditionalAwardsTotal</div>
            @foreach (var a in badges.AdditionalAwards) { <div>@a.Name: @a.Count</div> }
        </div></div>
        <div class="line"><div class="label">For new members</div><div class="detail">
            @foreach (var i in badges.InvestitureItems) { <div>@i.Name: @i.Count</div> }
            @if (!badges.InvestitureItems.Any())
            {
                <div>None</div>
            }
        </div></div>
    }

    <div class="block">About these numbers</div>
    <div class="line"><div class="label">Notes</div><div class="detail">
        <div>Youth are the unit's current youth members. A new member is one invested (Introduction to Section) in the period.</div>
        <div>Terrain only lists current members, so people who left are found from the next section's unit, the roster saved by the last report and events they came to in the period.</div>
        <div>Badges are those awarded in the period to current youth in this section; a member who jumped several Outdoor Adventure Skill levels at once only needs the highest.</div>
    </div></div>
</div>

@code {
    [Parameter]
    public SectionReportSet Report { get; set; } = new SectionReportSet();

    // Terrain lists only current members, so the youth count and ages are as at the day the report was made
    private string AsAt => Report.GeneratedAt.ToString("d MMM yyyy");

    // The logo of the first section, as in the exported report
    private string LogoFile => (Report.Sections.FirstOrDefault()?.Section ?? "") switch
    {
        "joey" => "Joey Scouts Full Col Vertical.jpg",
        "cub" => "Cub Scouts Full Col Vertical.png",
        "scout" => "Scouts Full Col Vertical.jpg",
        "venturer" => "Venturer Scouts Full Col Vertical.jpg",
        "rover" => "Rover Scouts Full Col Vertical.jpg",
        _ => ""
    };

    private static string Title(string key) => CultureInfo.InvariantCulture.TextInfo.ToTitleCase(key);

    private static string NamesOf(SectionReportModel unit, NewMemberOrigin origin)
    {
        var names = unit.NewMembers.Where(n => n.Origin == origin).Select(n => n.Name).ToList();
        return names.Count == 0 ? "" : " - " + string.Join(", ", names);
    }
}
