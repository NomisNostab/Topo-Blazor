@page "/milestone"
@inherits Controller.MilestoneController

<PageTitle>Topo / Milestone</PageTitle>

<EditForm Model="@model">
    <DataAnnotationsValidator />
    <div class="mt-3 mb-3 row">
        <h2>Milestone @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">
            Select Unit
        </label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
            <ValidationMessage For="@(() => model.UnitId)" />
        </div>
        <div class ="col-sm-7">
        </div>
    </div>

    <div class="mt-3 mb-3 row">
        <div class="col-sm-3">
            <InputCheckbox id="breakByPatrol" class="form-check-input"
                           @bind-Value="model.BreakByPatrol" @bind-Value:after="BreakByPatrolChanged" />
            <label class="form-check-label" for="breakByPatrol">
                Break by Patrol
            </label>
        </div>
        <div class="col-sm-3">
            <InputCheckbox id="suppressLastName" class="form-check-input"
                           @bind-Value="model.SuppressLastName" @bind-Value:after="SuppressLastNameChanged" />
            <label class="form-check-label" for="suppressLastName">
                Suppress Last Name
            </label>
        </div>
        <div class="col-sm-6">
        </div>
    </div>

    @if (Loading)
    {
        <div class="mt-3 mb-3">Reading @Progress...</div>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="mt-3 mb-3 text-danger">@ErrorMessage</div>
    }

    @if (Groups != null)
    {
        <div class="mt-3 mb-3 row">
            <div class="col-sm">
                <button type="button" class="btn btn-primary" @onclick="MilestoneReportPdfClick">Milestone Report (pdf)</button>
                <button type="button" class="btn btn-success" @onclick="MilestoneReportXlsxClick">Milestone Report (xlsx)</button>
            </div>
        </div>

        <MilestonePreview Groups="Groups" UnitName="@model.UnitName" />
    }

</EditForm>
