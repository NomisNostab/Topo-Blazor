@page "/sectionreport"
@inherits Controller.SectionReportController
@using Topo.Model.ReportGeneration
@using Topo.Model.SectionReport

<PageTitle>Topo / Section/Group Report</PageTitle>

<EditForm Model="@model">
    <div class="mt-3 mb-3 row">
        <h2>Section/Group Report @model.GroupName</h2>
    </div>

    <div class="form-group mb-3 row">
        <label class="col-sm-2 col-form-label">Units</label>
        <div class="col-sm-10 col-form-label">
            @if (model.Units.Count > 1)
            {
                <div>
                    <label>
                        <input type="checkbox" checked="@AllUnitsSelected"
                               @onchange="@(e => ToggleAllUnits((bool)(e.Value ?? false)))" /> All units
                    </label>
                </div>
            }
            <div class="d-flex flex-wrap gap-4">
                @foreach (var unit in model.Units)
                {
                    <label class="text-nowrap">
                        <input type="checkbox" checked="@model.SelectedUnits.Contains(unit.Key)"
                               @onchange="@(e => ToggleUnit(unit.Key, (bool)(e.Value ?? false)))" /> @unit.Value
                    </label>
                }
            </div>
            @if (model.Units.Count > 1)
            {
                <div class="text-muted small">Tick one unit for a section report, or several for a group report.</div>
            }
        </div>
    </div>

    <div class="form-group mb-3 row">
        <label class="col-sm-2 col-form-label">Calendars</label>
        <div class="col-sm-10 col-form-label">
            <div class="d-flex flex-wrap gap-4">
                @foreach (var column in CalendarColumns())
                {
                    <div class="d-flex flex-column">
                        @foreach (var calendar in column)
                        {
                            <label class="text-nowrap">
                                <input type="checkbox" checked="@model.SelectedCalendars.Contains(calendar.Key)"
                                       @onchange="@(e => ToggleCalendar(calendar.Key, (bool)(e.Value ?? false)))" /> @calendar.Value
                            </label>
                        }
                    </div>
                }
            </div>
            <div class="text-muted small">Ticking a unit ticks the calendar named after it. A unit reads its events from its own calendar and from any other calendar ticked here that is not another unit's.</div>
        </div>
    </div>

    <div class="mt-3 mb-3 row">
        <label class="col-sm-2 col-form-label">Period</label>
        <div class="col-sm-10 col-form-label">
            <button type="button" class="btn btn-outline-secondary btn-sm me-1" @onclick="LastMonth">Last month</button>
            <button type="button" class="btn btn-outline-secondary btn-sm me-1" @onclick="ThisQuarter">This quarter</button>
            <button type="button" class="btn btn-outline-secondary btn-sm me-1" @onclick="LastQuarter">Last quarter</button>
            <button type="button" class="btn btn-outline-secondary btn-sm" @onclick="ThisYear">This year</button>
        </div>
    </div>
    <div class="mt-3 mb-3 row">
        <label class="col-sm-2 col-form-label">From Date</label>
        <div class="col-sm-3">
            <InputDate @bind-Value="@model.From" class="form-control" />
        </div>
        <label class="col-sm-2 col-form-label">To Date</label>
        <div class="col-sm-3">
            <InputDate @bind-Value="@model.To" class="form-control" />
        </div>
    </div>
    <div class="mt-3 mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                <input type="checkbox" @bind="model.SaveRoster" /> Remember the roster when I download the report, so the next one can name who joined or left
            </label>
        </div>
    </div>

    <div class="mt-3 mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="GenerateClick">Generate Section/Group Report</button>
            @if (Busy)
            {
                <span class="ms-3">Reading @Progress... this can take a few minutes.</span>
            }
            @if (!string.IsNullOrEmpty(model.ErrorMessage))
            {
                <span class="ms-3 text-danger">@model.ErrorMessage</span>
            }
        </div>
    </div>
</EditForm>

@if (Result != null)
{
    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="@(() => DownloadClick(OutputType.PDF))">@ReportName (pdf)</button>
        <button type="button" class="btn btn-success" @onclick="@(() => DownloadClick(OutputType.Excel))">@ReportName (xlsx)</button>
        @if (!string.IsNullOrEmpty(model.Message))
        {
            <span class="ms-3 text-success">@model.Message</span>
        }
    </div>

    <SectionReportView Report="Result.Report" />
}
