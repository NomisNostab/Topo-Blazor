@page "/scoutinghistory/unit"
@inherits Controller.UnitReportController
@using Topo.Model.ReportGeneration

<PageTitle>Topo / Unit History</PageTitle>

<EditForm Model="@model">
    <div class="mt-3 mb-3 row">
        <h2>Scouting History @model.GroupName</h2>
    </div>

    <ScoutingHistorySubNav />

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">Select Unit</label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <label class="col-sm-2 col-form-label">Calendars</label>
        <div class="col-sm-10 col-form-label">
            @* columns of calendars, shortest names together, so each column is only as wide as its longest name *@
            <div class="d-flex flex-wrap gap-4">
                @foreach (var column in CalendarColumns())
                {
                    <div class="d-flex flex-column">
                        @foreach (var calendar in column)
                        {
                            <label class="text-nowrap">
                                <input type="checkbox" checked="@model.SelectedCalendars.Contains(calendar.Key)"
                                       @onchange="@(e => ToggleCalendar(calendar.Key, (bool)(e.Value ?? false)))" /> @calendar.Value
                            </label>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="mt-3 mb-3 row">
        <label class="col-sm-2 col-form-label">Period</label>
        <div class="col-sm-10 col-form-label">
            <label>
                <input type="checkbox" checked="@model.AllTime" @onchange="AllTimeChange" /> All time
            </label>
        </div>
    </div>

    @if (!model.AllTime)
    {
        <div class="mt-3 mb-3 row">
            <label class="col-sm-2 col-form-label">From Date</label>
            <div class="col-sm-3">
                <InputDate @bind-Value="@model.FromDate" class="form-control" />
            </div>
            <label class="col-sm-2 col-form-label">To Date</label>
            <div class="col-sm-3">
                <InputDate @bind-Value="@model.ToDate" class="form-control" />
            </div>
        </div>
    }

    <div class="mt-3 mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <button type="button" class="btn btn-primary" disabled="@Busy" @onclick="GenerateClick">Generate Unit History</button>
            @if (Busy)
            {
                <span class="ms-3">Reading @Progress... @(model.AllTime ? "all time can take several minutes." : "this can take a minute or two.")</span>
            }
            @if (!string.IsNullOrEmpty(model.ErrorMessage))
            {
                <span class="ms-3 text-danger">@model.ErrorMessage</span>
            }
        </div>
    </div>
</EditForm>

@if (model.Report != null)
{
    var report = model.Report;

    <div class="mb-3">
        <button type="button" class="btn btn-primary" @onclick="@(() => DownloadClick(OutputType.PDF))">Unit History (pdf)</button>
        <button type="button" class="btn btn-success" @onclick="@(() => DownloadClick(OutputType.Excel))">Unit History (xlsx)</button>
    </div>

    <UnitReportView Report="report" />
}
