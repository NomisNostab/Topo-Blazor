@page "/readytosubmit"
@inherits Controller.ReadyToSubmitController
@using Topo.Model.ReadyToSubmit

<PageTitle>Topo / Ready to Submit</PageTitle>

<EditForm Model="@model">
    <div class="mt-3 mb-3 row">
        <h2>Ready to Submit @model.GroupName</h2>
    </div>
    <p class="text-muted">Badges that have everything done but have not been sent for review or approval.</p>

    <div class="form-group mb-3 row">
        <label for="unit" class="col-sm-2 col-form-label">Select Unit</label>
        <div class="col-sm-3">
            <select id="unit" class="form-select" value="@model.UnitId" @onchange="UnitChange" disabled="@Loading">
                <option value="">Select unit</option>
                @foreach (var unit in model.Units)
                {
                    <option value="@unit.Key">@unit.Value</option>
                }
            </select>
        </div>
        @if (Loading)
        {
            <div class="col-sm-7 col-form-label">Reading @Progress... this can take a minute.</div>
        }
        @if (!string.IsNullOrEmpty(model.ErrorMessage))
        {
            <div class="col-sm-7 col-form-label text-danger">@model.ErrorMessage</div>
        }
    </div>

    <div class="form-group mb-3 row">
        <label class="col-sm-2 col-form-label">Badges</label>
        <div class="col-sm-10 col-form-label">
            <div class="d-flex flex-wrap gap-4">
                <label><input type="checkbox" @bind="model.Milestones" @bind:after="OptionChanged" /> Milestones</label>
                <label><input type="checkbox" @bind="model.OutdoorAdventureSkills" @bind:after="OptionChanged" /> Outdoor Adventure Skills</label>
                <label><input type="checkbox" @bind="model.SpecialInterestAreas" @bind:after="OptionChanged" /> Special Interest Areas</label>
                <label><input type="checkbox" @bind="model.PeakAwardParts" @bind:after="OptionChanged" /> Peak Award parts</label>
            </div>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                <input type="checkbox" @bind="model.LogbookTickOptional" @bind:after="OptionChanged" disabled="@(!model.OutdoorAdventureSkills)" />
                List Outdoor Adventure Skill stages that are only waiting on the Scout's logbook tick
            </label>
        </div>
    </div>
    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                List Outdoor Adventure Skill stages up to
                <input type="number" min="0" max="30" class="form-control form-control-sm d-inline-block mx-1" style="width: 5rem;" @bind="model.MaxTicksShort" @bind:after="OptionChanged" disabled="@(!model.OutdoorAdventureSkills)" />
                ticks short (0 for none)
            </label>
        </div>
    </div>

    <div class="form-group mb-3 row">
        <div class="col-sm-2"></div>
        <div class="col-sm-10">
            <label>
                <input type="checkbox" @bind="model.UseFullNames" @bind:after="OptionChanged" />
                Use full names (otherwise first name plus enough of the surname to tell Scouts apart)
            </label>
        </div>
    </div>

    @if (Report != null)
    {
        <div class="mt-3 mb-3 row">
            <div class="col-sm-2"></div>
            <div class="col-sm-10">
                <button type="button" class="btn btn-primary" @onclick="PdfClick">Ready to Submit (pdf)</button>
                <button type="button" class="btn btn-success" @onclick="XlsxClick">Ready to Submit (xlsx)</button>
            </div>
        </div>

        <div class="mt-3 mb-3 row">
            <label class="col-sm-2 col-form-label">Preview</label>
            <div class="col-sm-10">
                <ReadyToSubmitPreview Report="Report" />
            </div>
        </div>
    }
</EditForm>
